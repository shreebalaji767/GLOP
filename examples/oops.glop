// GLOP OOPS object-oriented programming
OOPS Person {
    WIZARD init(name, age) {
        THIS.name = name
        THIS.age = age
    }

    WIZARD greet() {
        YEET "HELLO " + THIS.name
    }

    WIZARD birthday() {
        THIS.age += 1
        YEET THIS.age
    }
}

GLOP person = NEW Person("RAVI", 25)
YAP person.name
YAP person.greet()
YAP person.birthday()
YAP person.age
